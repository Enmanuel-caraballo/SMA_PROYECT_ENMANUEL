# Copia este archivo como .env y llena los valores. El .env NO se sube a Git (está en .gitignore).

# Bot de Telegram del Comunicador (se crea con @BotFather -> /newbot)
TELEGRAM_TOKEN=
# IDs de los grupos: los llena  python agentes/comunicador.py --buscar-chats
TELEGRAM_CHAT_CIUDADANIA=
TELEGRAM_CHAT_POLICIA=

# LLM que redacta los avisos: ollama (local, recomendado), gemini o ninguno (solo plantilla)
LLM=ollama
OLLAMA_MODELO=llama3.2:3b
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
